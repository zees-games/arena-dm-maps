# Signed packs and CDN mirrors are derived; the maps are the source.
/dist/
/mirror/
__pycache__/
# Map content (meshes, textures, packs) is not kept in git; it is published through the CDN flow.
/maps/*
!/maps/.gitkeep
/pbr-library/
/model-library/
/sources/
/.stores/
# cp-orange-x3 is commercial content used by the owner's decision and never published: its world stays local too.
/worlds/cp-orange-x3/
